@model RouteX.Models.User
@{
    ViewData["Title"] = "Profile Settings";
    bool twoFactorEnabled = ViewBag.TwoFactorEnabled ?? false;
}

<style>
    .profile-container {
        padding: 30px;
        background: #f8f9fa;
        min-height: calc(100vh - 70px);
    }

    .profile-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        border: 1px solid #e9ecef;
        overflow: hidden;
        margin-bottom: 30px;
    }

    .profile-header {
        background: linear-gradient(135deg, #ff6b35 0%, #ff8c42 100%);
        padding: 40px 30px;
        color: white;
        display: flex;
        align-items: center;
        gap: 24px;
        position: relative;
    }

    .profile-avatar-large {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.2rem;
        border: 3px solid rgba(255, 255, 255, 0.4);
    }

    .profile-meta h2 {
        margin: 0 0 6px 0;
        font-weight: 700;
        font-size: 1.8rem;
    }

    .profile-meta span {
        background: rgba(255, 255, 255, 0.15);
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    .profile-body {
        padding: 40px 30px;
    }

    .section-title {
        font-size: 1.2rem;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 24px;
        padding-bottom: 10px;
        border-bottom: 2px solid #f1f3f5;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .form-label {
        font-weight: 600;
        color: #495057;
        font-size: 0.9rem;
    }

    .form-control-static {
        padding: 10px 14px;
        background: #f1f3f5;
        border-radius: 8px;
        border: 1px solid #e9ecef;
        color: #495057;
        font-weight: 500;
    }

    .btn-save {
        background: linear-gradient(135deg, #ff6b35 0%, #e55a2b 100%);
        color: white;
        border: none;
        border-radius: 8px;
        padding: 12px 30px;
        font-weight: 600;
        transition: all 0.2s ease;
    }

    .btn-save:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 15px rgba(255, 107, 53, 0.3);
        color: white;
    }

    /* 2FA Toggle Styling */
    .security-box {
        background: #fff9f6;
        border: 1px dashed #ffd8cc;
        border-radius: 12px;
        padding: 24px;
        margin-top: 20px;
    }

    .switch {
        position: relative;
        display: inline-block;
        width: 50px;
        height: 26px;
    }

    .switch input {
        opacity: 0;
        width: 0;
        height: 0;
    }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #ccc;
        transition: .4s;
        border-radius: 34px;
    }

    .slider:before {
        position: absolute;
        content: "";
        height: 18px;
        width: 18px;
        left: 4px;
        bottom: 4px;
        background-color: white;
        transition: .4s;
        border-radius: 50%;
    }

    input:checked + .slider {
        background-color: #ff6b35;
    }

    input:checked + .slider:before {
        transform: translateX(24px);
    }

    .badge-mfa {
        font-size: 0.8rem;
        padding: 6px 12px;
        border-radius: 20px;
        font-weight: 600;
    }
</style>

<div class="profile-container">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="border-radius: 10px; background-color: #d4edda; color: #155724;">
            <div class="d-flex align-items-center gap-2">
                <i class="fas fa-check-circle"></i>
                <div>@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" style="font-size: 0.8rem;"></button>
        </div>
    }

    <div class="profile-card">
        <div class="profile-header">
            <div class="profile-avatar-large">
                <i class="fas fa-user"></i>
            </div>
            <div class="profile-meta">
                <h2>@Model.FirstName @Model.LastName</h2>
                <span>@Model.Role</span>
            </div>
        </div>

        <div class="profile-body">
            <form method="post" action="@Url.Action("UpdateProfile", "Account")">
                @Html.AntiForgeryToken()

                <div class="section-title">
                    <i class="fas fa-user-cog" style="color: #ff6b35;"></i> Personal Information
                </div>

                <div class="row mb-4">
                    <div class="col-md-6 mb-3">
                        <label for="firstName" class="form-label">First Name</label>
                        <input type="text" class="form-control form-control-lg" id="firstName" name="firstName" value="@Model.FirstName" required style="border-radius: 8px; font-size: 0.95rem;" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="lastName" class="form-label">Last Name</label>
                        <input type="text" class="form-control form-control-lg" id="lastName" name="lastName" value="@Model.LastName" required style="border-radius: 8px; font-size: 0.95rem;" />
                    </div>
                </div>

                <div class="row mb-5">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Email Address</label>
                        <div class="form-control-static">@Model.Email</div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Role</label>
                        <div class="form-control-static">@Model.Role</div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Assigned Branch</label>
                        <div class="form-control-static">@(Model.Branch?.BranchName ?? "All Access")</div>
                    </div>
                </div>

                <div class="section-title">
                    <i class="fas fa-shield-alt" style="color: #ff6b35;"></i> Security Settings
                </div>

                <div class="security-box mb-5">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <h4 class="m-0" style="font-weight: 700; color: #2c3e50; font-size: 1.1rem;">Multi-Factor Authentication (MFA)</h4>
                                <span class="badge-mfa @(twoFactorEnabled ? "bg-success text-white" : "bg-secondary text-white")">
                                    @(twoFactorEnabled ? "Enabled" : "Disabled")
                                </span>
                            </div>
                            <p class="text-muted m-0" style="font-size: 0.88rem; max-width: 600px;">
                                Secure your account with double verification. When enabled, a 6-digit verification code will be sent to your email <strong>(@Model.Email)</strong> each time you attempt to log in.
                            </p>
                        </div>
                        <div class="pt-1">
                            <label class="switch">
                                <input type="checkbox" name="enable2Fa" value="true" @(twoFactorEnabled ? "checked" : "") />
                                <span class="slider"></span>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="text-end">
                    <button type="submit" class="btn btn-save btn-lg px-5">
                        <i class="fas fa-save me-2"></i> Save Settings
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
